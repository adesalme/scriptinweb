# Exemple de variables d'environnement

# Backend
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BACKEND_SECRET_KEY=
DATABASE_URL=postgresql://user:password@db:5432/scriptinweb
REDIS_URL=redis://redis:6379/0

# Frontend
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_AZURE_CLIENT_ID=

# PowerShell Runner
POWERSHELL_RUNNER_IMAGE=scriptinweb-pwsh:latest

# Nginx
NGINX_HOST=localhost
NGINX_PORT=80